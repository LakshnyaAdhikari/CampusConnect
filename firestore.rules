rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth & Permission Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (userDocExists() && getUserData().role == 'admin')
      );
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role in ['admin', 'moderator'] ||
        (userDocExists() && getUserData().role in ['admin', 'moderator'])
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // On creation, users can only create their own profile and must default to student
      allow create: if isOwner(userId) &&
                    request.resource.data.uid == userId &&
                    request.resource.data.role == 'student';
      // On update, users cannot change their role, uid, or id; only admins can change roles
      allow update: if (isOwner(userId) &&
                        request.resource.data.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'id']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Connections Collection
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      // New connections must be initiated by sender and start in pending status
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == 'pending'
      );
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
    }

    // Chats Collection
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      allow delete: if isAdmin();

      // Messages Subcollection: strictly restricted to participants of the parent chat
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderUid == request.auth.uid
        );
        allow update, delete: if false; // Chat messages cannot be altered or removed by clients
      }
    }

    // Spaces Collection
    match /spaces/{spaceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isStaff() || (resource.data.createdBy == request.auth.uid);

      match /posts/{postId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          request.resource.data.isAnonymous == true ||
          request.resource.data.authorUid == request.auth.uid
        );
        allow update, delete: if isAuthenticated() && (
          resource.data.authorUid == request.auth.uid || isStaff()
        );

        match /comments/{commentId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && (
            request.resource.data.isAnonymous == true ||
            request.resource.data.authorUid == request.auth.uid
          );
          allow update, delete: if isAuthenticated() && (
            resource.data.authorUid == request.auth.uid || isStaff()
          );
        }
      }
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.reporterUid == request.auth.uid);
      allow create: if isAuthenticated() &&
                    request.resource.data.reporterUid == request.auth.uid &&
                    request.resource.data.status == 'open';
      allow update, delete: if isStaff();
    }
  }
}
