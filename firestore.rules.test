
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('campusRole', '') == 'admin';
    }

    function isLegacyModerator() {
      let moderatorProfile = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null
        && exists(moderatorProfile)
        && get(moderatorProfile).data.role == 'moderator';
    }

    function isSpaceStaff() {
      return isAdmin() || isLegacyModerator();
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // USER NOTIFICATIONS
    // ==========================================

    match /notifications/{notificationId} {
      function actorProfilePath() {
        return /databases/$(database)/documents/users/$(request.auth.uid);
      }

      function notificationPath(targetId) {
        return /databases/$(database)/documents/notifications/$(targetId);
      }

      function connectionPath(connectionId) {
        return /databases/$(database)/documents/connections/$(connectionId);
      }

      function chatPath(chatId) {
        return /databases/$(database)/documents/chats/$(chatId);
      }

      function messagePath(chatId, messageId) {
        return /databases/$(database)/documents/chats/$(chatId)/messages/$(messageId);
      }

      function spacePath(spaceId) {
        return /databases/$(database)/documents/spaces/$(spaceId);
      }

      function joinRequestPath(spaceId, requesterUid) {
        return /databases/$(database)/documents/spaces/$(spaceId)/joinRequests/$(requesterUid);
      }

      function validEnvelope() {
        return request.auth != null
          && request.resource.data.recipientUid is string
          && request.resource.data.recipientUid.size() > 0
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorUid != request.resource.data.recipientUid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() > 0
          && request.resource.data.actorName.size() <= 80
          && exists(actorProfilePath())
          && get(actorProfilePath()).data.name == request.resource.data.actorName
          && request.resource.data.createdAt is timestamp
          && request.resource.data.read == false;
      }

      function validConnectionRequestEvent() {
        return request.resource.data.type == 'connection_request'
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'connectionId'
          ])
          && validConnectionRequestEventDetails();
      }

      function validConnectionRequestEventDetails() {
        let sourcePath = connectionPath(request.resource.data.connectionId);
        return request.resource.data.keys().hasOnly([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'connectionId'
          ])
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'connectionId'
          ])
          && request.resource.data.connectionId is string
          && !exists(sourcePath)
          && existsAfter(sourcePath)
          && getAfter(sourcePath).data.notificationKey == notificationId
          && getAfter(sourcePath).data.status == 'pending'
          && getAfter(sourcePath).data.fromUid == request.resource.data.actorUid
          && getAfter(sourcePath).data.toUid == request.resource.data.recipientUid;
      }

      function validConnectionAcceptedEvent() {
        return request.resource.data.type == 'connection_accepted'
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'connectionId'
          ])
          && validConnectionAcceptedEventDetails();
      }

      function validConnectionAcceptedEventDetails() {
        let sourcePath = connectionPath(request.resource.data.connectionId);
        return request.resource.data.keys().hasOnly([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'connectionId'
          ])
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'connectionId'
          ])
          && request.resource.data.connectionId is string
          && exists(sourcePath)
          && existsAfter(sourcePath)
          && get(sourcePath).data.status == 'pending'
          && getAfter(sourcePath).data.status == 'accepted'
          && getAfter(sourcePath).data.notificationKey is string
          && notificationId == 'connection_accepted_' + getAfter(sourcePath).data.notificationKey
          && getAfter(sourcePath).data.fromUid == request.resource.data.recipientUid
          && getAfter(sourcePath).data.toUid == request.resource.data.actorUid;
      }

      function validMessageEvent() {
        return request.resource.data.type == 'message_received'
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'chatId', 'messageId'
          ])
          && validMessageEventDetails();
      }

      function validMessageEventDetails() {
        let sourcePath = messagePath(request.resource.data.chatId, request.resource.data.messageId);
        let parentChatPath = chatPath(request.resource.data.chatId);
        return request.resource.data.keys().hasOnly([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'chatId', 'messageId'
          ])
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'chatId', 'messageId'
          ])
          && request.resource.data.chatId is string
          && request.resource.data.messageId is string
          && notificationId == 'message_' + request.resource.data.messageId
          && exists(parentChatPath)
          && get(parentChatPath).data.participants.hasAll([
            request.resource.data.actorUid,
            request.resource.data.recipientUid
          ])
          && !exists(sourcePath)
          && existsAfter(sourcePath)
          && getAfter(sourcePath).data.id == request.resource.data.messageId
          && getAfter(sourcePath).data.senderUid == request.resource.data.actorUid;
      }

      function validSpaceJoinRequestEvent() {
        return request.resource.data.type == 'space_join_request'
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'spaceId', 'spaceName', 'requestUid'
          ])
          && validSpaceJoinRequestEventDetails();
      }

      function validSpaceJoinRequestEventDetails() {
        let targetSpacePath = spacePath(request.resource.data.spaceId);
        let sourcePath = joinRequestPath(request.resource.data.spaceId, request.resource.data.requestUid);
        let sourceCreated = !exists(sourcePath)
          && existsAfter(sourcePath)
          && getAfter(sourcePath).data.status == 'pending'
          && getAfter(sourcePath).data.uid == request.resource.data.requestUid
          && getAfter(sourcePath).data.notificationKey == notificationId;
        let sourceReset = exists(sourcePath)
          && get(sourcePath).data.status in ['approved', 'rejected']
          && getAfter(sourcePath).data.status == 'pending'
          && getAfter(sourcePath).data.uid == request.resource.data.requestUid
          && getAfter(sourcePath).data.notificationKey == notificationId
          && getAfter(sourcePath).data.notificationKey != get(sourcePath).data.get('notificationKey', '')
          && getAfter(sourcePath).data.createdAt > get(sourcePath).data.createdAt;
        return request.resource.data.keys().hasOnly([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'spaceId', 'spaceName', 'requestUid'
          ])
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'spaceId', 'spaceName', 'requestUid'
          ])
          && request.resource.data.spaceId is string
          && request.resource.data.requestUid == request.resource.data.actorUid
          && notificationId is string
          && exists(targetSpacePath)
          && get(targetSpacePath).data.visibility == 'private'
          && get(targetSpacePath).data.createdBy == request.resource.data.recipientUid
          && request.resource.data.spaceName == get(targetSpacePath).data.name
          && request.resource.data.actorUid != request.resource.data.recipientUid
          && (sourceCreated || sourceReset);
      }

      function validSpaceDecisionEvent() {
        return request.resource.data.type in ['space_join_approved', 'space_join_rejected']
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'spaceId', 'spaceName', 'requestUid'
          ])
          && validSpaceDecisionEventDetails();
      }

      function validSpaceDecisionEventDetails() {
        let targetSpacePath = spacePath(request.resource.data.spaceId);
        let sourcePath = joinRequestPath(request.resource.data.spaceId, request.resource.data.requestUid);
        let approved = request.resource.data.type == 'space_join_approved';
        return request.resource.data.keys().hasOnly([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'spaceId', 'spaceName', 'requestUid'
          ])
          && request.resource.data.keys().hasAll([
            'recipientUid', 'type', 'actorUid', 'actorName', 'createdAt', 'read', 'spaceId', 'spaceName', 'requestUid'
          ])
          && request.resource.data.spaceId is string
          && request.resource.data.requestUid == request.resource.data.recipientUid
          && exists(targetSpacePath)
          && get(targetSpacePath).data.visibility == 'private'
          && request.resource.data.spaceName == get(targetSpacePath).data.name
          && exists(sourcePath)
          && existsAfter(sourcePath)
          && get(sourcePath).data.status == 'pending'
          && get(sourcePath).data.uid == request.resource.data.recipientUid
          && getAfter(sourcePath).data.status == (approved ? 'approved' : 'rejected')
          && getAfter(sourcePath).data.reviewedBy == request.resource.data.actorUid
          && getAfter(sourcePath).data.notificationKey is string
          && notificationId == 'space_decision_' + getAfter(sourcePath).data.notificationKey;
      }

      allow get, list: if request.auth != null
        && resource.data.recipientUid == request.auth.uid;

      allow create: if validEnvelope()
        && (
          validConnectionRequestEvent()
          || validConnectionAcceptedEvent()
          || validMessageEvent()
          || validSpaceJoinRequestEvent()
          || validSpaceDecisionEvent()
        );

      allow update: if request.auth != null
        && resource.data.recipientUid == request.auth.uid
        && resource.data.read == false
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    // ==========================================
    // USER REPORTS AND MODERATION
    // ==========================================

    match /reports/{reportId} {
      function signedIn() {
        return request.auth != null;
      }

      function userProfilePath(uid) {
        return /databases/$(database)/documents/users/$(uid);
      }

      function publicProfilePath(uid) {
        return /databases/$(database)/documents/publicProfiles/$(uid);
      }

      function spacePath(spaceId) {
        return /databases/$(database)/documents/spaces/$(spaceId);
      }

      function postPath(spaceId, postId) {
        return /databases/$(database)/documents/spaces/$(spaceId)/posts/$(postId);
      }

      function validCategory(category) {
        return category in ['spam', 'harassment', 'inappropriate_content', 'safety', 'other'];
      }

      // Reports may point only to public profiles and non-private Spaces/posts
      // the reporter can browse. Private messages and private Space content are
      // deliberately not valid report targets.
      function reportableSpace(spaceId) {
        let path = spacePath(spaceId);
        let space = get(path).data;
        let visibility = space.get('visibility', 'campus');
        return exists(path)
          && (visibility == 'public'
            || (visibility == 'campus'
              && exists(userProfilePath(request.auth.uid))
              && get(userProfilePath(request.auth.uid)).data.get('campus', '') == space.campus));
      }

      function validTarget() {
        let data = request.resource.data;
        return (data.targetType == 'profile'
            && data.targetId != request.auth.uid
            && exists(publicProfilePath(data.targetId))
            && get(publicProfilePath(data.targetId)).data.get('discoverable', false) == true)
          || (data.targetType == 'space'
            && reportableSpace(data.targetId))
          || (data.targetType == 'post'
            && reportableSpace(data.spaceId)
            && exists(postPath(data.spaceId, data.targetId)));
      }

      function validBaseFields() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'reporterUid', 'targetType', 'targetId', 'category', 'reason',
            'status', 'createdAt', 'updatedAt'
          ])
          && data.reporterUid == request.auth.uid
          && data.targetType in ['profile', 'space', 'post']
          && data.targetId is string
          && data.targetId.size() > 0
          && data.targetId.size() <= 128
          && validCategory(data.category)
          && data.reason is string
          && data.reason.size() > 0
          && data.reason.size() <= 1000
          && data.status == 'pending'
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      function validCreateFields() {
        let data = request.resource.data;
        return (data.targetType == 'post'
            && data.keys().hasOnly([
              'reporterUid', 'targetType', 'targetId', 'spaceId', 'category',
              'reason', 'status', 'createdAt', 'updatedAt'
            ])
            && data.spaceId is string
            && data.spaceId.size() > 0
            && data.spaceId.size() <= 128)
          || (data.targetType in ['profile', 'space']
            && !('spaceId' in data)
            && data.keys().hasOnly([
              'reporterUid', 'targetType', 'targetId', 'category', 'reason',
              'status', 'createdAt', 'updatedAt'
            ]));
      }

      function validModerationUpdate() {
        let old = resource.data;
        let next = request.resource.data;
        let statusTransition = (old.status == 'pending'
            && next.status in ['under_review', 'resolved', 'dismissed'])
          || (old.status == 'under_review'
            && next.status in ['under_review', 'resolved', 'dismissed']);
        return next.keys().hasAll([
            'reporterUid', 'targetType', 'targetId', 'category', 'reason',
            'status', 'createdAt', 'updatedAt', 'reviewedBy', 'reviewedAt'
          ])
          && next.keys().hasOnly([
            'reporterUid', 'targetType', 'targetId', 'spaceId', 'category',
            'reason', 'status', 'createdAt', 'updatedAt',
            'reviewedBy', 'reviewedAt'
          ])
          && next.reporterUid == old.reporterUid
          && next.targetType == old.targetType
          && next.targetId == old.targetId
          && next.category == old.category
          && next.reason == old.reason
          && next.createdAt == old.createdAt
          && ((old.targetType == 'post' && next.spaceId == old.spaceId)
            || (old.targetType != 'post'
              && !('spaceId' in old)
              && !('spaceId' in next)))
          && next.status in ['pending', 'under_review', 'resolved', 'dismissed']
          && statusTransition
          && next.updatedAt == request.time
          && next.reviewedBy == request.auth.uid
          && next.reviewedAt == request.time
          && next.diff(old).affectedKeys().hasOnly([
            'status', 'updatedAt', 'reviewedBy', 'reviewedAt'
          ]);
      }

      allow get, list: if signedIn()
        && (isAdmin() || resource.data.reporterUid == request.auth.uid);

      allow create: if signedIn()
        && validBaseFields()
        && validCreateFields()
        && validTarget();

      allow update: if isAdmin() && validModerationUpdate();
      allow delete: if false;

      match /moderationNotes/{noteId} {
        function reportPath() {
          return /databases/$(database)/documents/reports/$(reportId);
        }

        allow get, list: if isAdmin();

        allow create: if isAdmin()
          && exists(reportPath())
          && request.resource.data.keys().hasOnly(['authorUid', 'note', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorUid', 'note', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.note is string
          && request.resource.data.note.size() > 0
          && request.resource.data.note.size() <= 1000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // ==========================================
    // PRIVATE USER PROFILES
    // ==========================================

    match /users/{uid} {

      allow get: if request.auth != null
        && request.auth.uid == uid;

      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student';

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'campus',
          'interests',
          'teach',
          'learn',
          'lookingFor',
          'bio',
          'photoURL',
          'discoverable',
          'onboarded',
          'updatedAt'
        ]);

      allow delete: if request.auth != null
        && request.auth.uid == uid;

      match /spaceMemberships/{spaceId} {
        function targetSpacePath() {
          return /databases/$(database)/documents/spaces/$(spaceId);
        }

        function targetJoinRequestPath() {
          return /databases/$(database)/documents/spaces/$(spaceId)/joinRequests/$(uid);
        }

        function targetSpaceOwnerOrStaff() {
          return exists(targetSpacePath())
            && (get(targetSpacePath()).data.createdBy == request.auth.uid
              || isSpaceStaff());
        }

        allow get, list: if request.auth != null && request.auth.uid == uid;

        function isSelfMembershipIndex() {
          let spacePath = targetSpacePath();
          return request.auth.uid == uid
            && existsAfter(spacePath)
            && uid in getAfter(spacePath).data.members;
        }

        // The Space members array is authoritative. A self index can only point
        // to the caller's membership (including repair of an existing member's
        // missing locator); it cannot add the caller to the Space.
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['spaceId', 'joinedAt'])
          && request.resource.data.keys().hasAll(['spaceId', 'joinedAt'])
          && request.resource.data.spaceId == spaceId
          && request.resource.data.joinedAt is timestamp
          && existsAfter(targetSpacePath())
          && uid in getAfter(targetSpacePath()).data.members
          && (
            isSelfMembershipIndex()
            || (request.auth.uid != uid
              && targetSpaceOwnerOrStaff()
              && exists(targetJoinRequestPath())
              && get(targetJoinRequestPath()).data.uid == uid
              && get(targetJoinRequestPath()).data.status == 'pending'
              && existsAfter(targetJoinRequestPath())
              && getAfter(targetJoinRequestPath()).data.uid == uid
              && getAfter(targetJoinRequestPath()).data.status == 'approved'
              && getAfter(targetJoinRequestPath()).data.reviewedBy == request.auth.uid
              && !(uid in get(targetSpacePath()).data.members))
          );

        allow update: if false;
        allow delete: if request.auth != null
          && request.auth.uid == uid
          && existsAfter(targetSpacePath())
          && !(uid in getAfter(targetSpacePath()).data.members);
      }
    }

    // ==========================================
    // PUBLIC PROFILES
    // ==========================================

    match /publicProfiles/{uid} {

      function ownerCanPublish() {
        let userPath = /databases/$(database)/documents/users/$(uid);
        let owner = getAfter(userPath);

        return existsAfter(userPath)
          && owner.data.get('onboarded', false) == true
          && owner.data.get('discoverable', false) == true;
      }

      function validPublicProfile() {
        let data = request.resource.data;

        return data.keys().hasOnly([
          'uid',
          'name',
          'campus',
          'interests',
          'teach',
          'learn',
          'lookingFor',
          'bio',
          'photoURL',
          'discoverable',
          'createdAt'
        ])
        && data.keys().hasAll([
          'uid',
          'name',
          'campus',
          'interests',
          'teach',
          'learn',
          'lookingFor',
          'bio',
          'photoURL',
          'discoverable',
          'createdAt'
        ])
        && data.uid == uid
        && data.name is string
        && data.name.size() <= 80
        && data.campus is string
        && data.campus.size() <= 120
        && data.interests is list
        && data.interests.size() <= 40
        && data.teach is list
        && data.teach.size() <= 40
        && data.learn is list
        && data.learn.size() <= 40
        && data.lookingFor is list
        && data.lookingFor.size() <= 20
        && data.bio is string
        && data.bio.size() <= 500
        && data.photoURL is string
        && data.photoURL.size() <= 2048
        && data.discoverable == true
        && data.createdAt is timestamp;
      }

      allow get, list: if request.auth != null
        && resource.data.discoverable == true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && ownerCanPublish()
        && validPublicProfile();

      allow update: if request.auth != null
        && request.auth.uid == uid
        && ownerCanPublish()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validPublicProfile();

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    // ==========================================
    // CONNECTIONS
    // ==========================================

    match /connections/{connectionId} {
      function notificationPath(notificationId) {
        return /databases/$(database)/documents/notifications/$(notificationId);
      }

      // READ ONLY BY PARTICIPANTS
      allow get: if request.auth != null
        && (
          resource == null
          || request.auth.uid in resource.data.participants
        );

      // QUERY ONLY OWN CONNECTIONS
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // CREATE CONNECTION REQUEST
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'id',
          'fromUid',
          'toUid',
          'participants',
          'status',
          'profiles',
          'createdAt',
          'notificationKey'
        ])
        && request.resource.data.id == connectionId
        && (
          connectionId ==
            request.resource.data.fromUid + '_' +
            request.resource.data.toUid
          ||
          connectionId ==
            request.resource.data.toUid + '_' +
            request.resource.data.fromUid
        )
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
          request.auth.uid,
          request.resource.data.toUid
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.notificationKey is string
        && request.resource.data.notificationKey.size() > 0
        && existsAfter(notificationPath(request.resource.data.notificationKey))
        && request.resource.data.profiles is map
        && request.resource.data.profiles.keys().hasOnly([
          request.auth.uid
        ])
        && request.resource.data.profiles[request.auth.uid].name is string;

      // ACCEPT CONNECTION REQUEST
      allow update: if request.auth != null
        && request.auth.uid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.notificationKey is string
        && (!('notificationKey' in resource.data)
          || request.resource.data.notificationKey == resource.data.notificationKey)
        && existsAfter(notificationPath('connection_accepted_' + request.resource.data.notificationKey))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'profiles',
          'updatedAt',
          'notificationKey'
        ])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.profiles is map
        && request.resource.data.profiles.keys().hasAll([
          resource.data.fromUid,
          resource.data.toUid
        ])
        && request.resource.data.profiles.keys().hasOnly([
          resource.data.fromUid,
          resource.data.toUid
        ])
        && request.resource.data.profiles[resource.data.fromUid]
          == resource.data.profiles[resource.data.fromUid]
        && request.resource.data.profiles[resource.data.toUid].name is string;

      // CANCEL, REJECT OR REMOVE CONNECTION
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants
        && (
          (
            resource.data.status == 'pending'
            && (
              request.auth.uid == resource.data.fromUid
              || request.auth.uid == resource.data.toUid
            )
          )
          ||
          resource.data.status == 'accepted'
        );
    }

    // ==========================================
    // CHATS
    // ==========================================

    match /chats/{chatId} {

      function isParticipant() {
        return request.auth != null
          && request.auth.uid in resource.data.participants;
      }

      function validAcceptedConnection(otherUid) {
        let connectionId = request.auth.uid < otherUid
          ? request.auth.uid + '_' + otherUid
          : otherUid + '_' + request.auth.uid;

        let connectionPath =
          /databases/$(database)/documents/connections/$(connectionId);

        return exists(connectionPath)
          && get(connectionPath).data.status == 'accepted'
          && get(connectionPath).data.participants.hasAll([
            request.auth.uid,
            otherUid
          ]);
      }

      // READ EXISTING CHATS; ALLOW CHECKING A MISSING CHAT
      allow get: if request.auth != null
        && (
          resource == null
          || request.auth.uid in resource.data.participants
        );

      // QUERY ONLY OWN CONVERSATIONS
      allow list: if isParticipant();

      // CREATE CHAT ONLY BETWEEN ACCEPTED CONNECTIONS
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'id',
          'participants',
          'lastMessage',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == chatId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && validAcceptedConnection(
          request.resource.data.participants[0] == request.auth.uid
            ? request.resource.data.participants[1]
            : request.resource.data.participants[0]
        );

      // UPDATE ONLY CONVERSATION METADATA
      allow update: if isParticipant()
        && request.resource.data.id == resource.data.id
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'updatedAt'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 5000
        && request.resource.data.updatedAt is timestamp;

      // NO CHAT DELETION
      allow delete: if false;

      // ========================================
      // INDIVIDUAL MESSAGES
      // ========================================

      match /messages/{messageId} {
        function notificationPath(notificationId) {
          return /databases/$(database)/documents/notifications/$(notificationId);
        }

        function chatParticipant() {
          let chatPath =
            /databases/$(database)/documents/chats/$(chatId);

          return request.auth != null
            && exists(chatPath)
            && request.auth.uid in get(chatPath).data.participants;
        }

        // READ MESSAGES ONLY BY CHAT PARTICIPANTS
        allow get, list: if chatParticipant();

        // SEND MESSAGE
        allow create: if chatParticipant()
          && request.resource.data.keys().hasOnly([
            'id',
            'senderUid',
            'text',
            'createdAt'
          ])
          && request.resource.data.id == messageId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt is timestamp
          && existsAfter(notificationPath('message_' + messageId));

        // NO EDITING OR DELETING MESSAGES
        allow update, delete: if false;
      }
    }

    // ==========================================
    // CAMPUS SPACES
    // ==========================================

    match /spaces/{spaceId} {
      function signedIn() {
        return request.auth != null;
      }

      function userPath() {
        return /databases/$(database)/documents/users/$(request.auth.uid);
      }

      function spacePath() {
        return /databases/$(database)/documents/spaces/$(spaceId);
      }

      function postPath(postId) {
        return /databases/$(database)/documents/spaces/$(spaceId)/posts/$(postId);
      }

      function isStaff() {
        return isSpaceStaff();
      }

      function isSameCampus() {
        return signedIn()
          && exists(userPath())
          && exists(spacePath())
          && get(userPath()).data.get('campus', '') == get(spacePath()).data.campus;
      }

      function isMember() {
        return signedIn()
          && exists(spacePath())
          && request.auth.uid in get(spacePath()).data.members;
      }

      function isOwner() {
        return signedIn()
          && exists(spacePath())
          && get(spacePath()).data.createdBy == request.auth.uid;
      }

      function canReadSpace() {
        return (signedIn()
            && exists(spacePath())
            && isPublicData(get(spacePath()).data))
          || (signedIn()
            && exists(spacePath())
            && isCampusScopedData(get(spacePath()).data)
            && isSameCampus())
          || isMember()
          || isOwner()
          || isStaff();
      }

      function isPublicData(data) {
        return 'visibility' in data && data.visibility == 'public';
      }

      function isCampusScopedData(data) {
        // Missing visibility preserves the original campus-only access model.
        return !('visibility' in data) || data.visibility == 'campus';
      }

      function isPrivateData(data) {
        return 'visibility' in data && data.visibility == 'private';
      }

      function isPublicSpace() {
        return isPublicData(resource.data);
      }

      function isCampusScopedSpace() {
        return isCampusScopedData(resource.data);
      }

      function isPrivateSpace() {
        return isPrivateData(resource.data);
      }

      function joinRequestPath(requestUid) {
        return /databases/$(database)/documents/spaces/$(spaceId)/joinRequests/$(requestUid);
      }

      function memberIndexPath(memberUid) {
        return /databases/$(database)/documents/users/$(memberUid)/spaceMemberships/$(spaceId);
      }

      function isApprovedPrivateJoin() {
        let oldMembers = resource.data.members.toSet();
        let newMembers = request.resource.data.members.toSet();
        let addedMembers = request.resource.data.members.removeAll(resource.data.members);
        let approvedUid = addedMembers.size() == 1 ? addedMembers[0] : '';
        let requestPath = joinRequestPath(approvedUid);

        return isPrivateSpace()
          && (isOwner() || isStaff())
          && approvedUid is string
          && request.auth.uid != approvedUid
          && addedMembers.size() == 1
          && newMembers.hasAll(oldMembers)
          && newMembers.size() == oldMembers.size() + 1
          && existsAfter(memberIndexPath(approvedUid))
          && getAfter(memberIndexPath(approvedUid)).data.spaceId == spaceId
          && exists(requestPath)
          && get(requestPath).data.uid == approvedUid
          && get(requestPath).data.status == 'pending'
          && existsAfter(requestPath)
          && getAfter(requestPath).data.uid == approvedUid
          && getAfter(requestPath).data.status == 'approved'
          && getAfter(requestPath).data.reviewedBy == request.auth.uid;
      }

      function isUniqueList(values) {
        return values is list && values.toSet().size() == values.size();
      }

      function validAuthorName() {
        let authorPath = userPath();
        return exists(authorPath)
          && get(authorPath).data.name is string
          && get(authorPath).data.name.size() > 0
          && get(authorPath).data.name.size() <= 80
          && request.resource.data.authorName == get(authorPath).data.name;
      }

      function validAuthorFields() {
        return (
          request.resource.data.isAnonymous == true
          && request.resource.data.authorName == 'Anonymous'
          && !('authorUid' in request.resource.data)
        ) || (
          request.resource.data.isAnonymous == false
          && request.resource.data.authorUid == request.auth.uid
          && validAuthorName()
        );
      }

      function isJoin() {
        return (isPublicSpace() || (isCampusScopedSpace() && isSameCampus()))
          && request.resource.data.members.toSet().size() == resource.data.members.toSet().size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && existsAfter(memberIndexPath(request.auth.uid))
          && getAfter(memberIndexPath(request.auth.uid)).data.spaceId == spaceId;
      }

      function isLeave() {
        return request.resource.data.members.toSet().size() == resource.data.members.toSet().size() - 1
          && resource.data.members.hasAll(request.resource.data.members)
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && !existsAfter(memberIndexPath(request.auth.uid));
      }

      function isMembershipRepair() {
        return request.resource.data.members.toSet() == resource.data.members.toSet()
          && request.resource.data.members.size() == resource.data.members.toSet().size();
      }

      allow get: if signedIn()
        && (isPublicSpace()
          || (isCampusScopedSpace() && isSameCampus())
          || request.auth.uid in resource.data.members
          || resource.data.createdBy == request.auth.uid
          || isStaff());
      // Public discovery is cross-campus. Legacy Spaces are listed only after the
      // migration tags them campus-scoped, and only with a campus-constrained query.
      allow list: if signedIn()
        && (isPublicSpace()
          || (isCampusScopedSpace()
            && resource.data.get('visibility', '') == 'campus'
            && exists(userPath())
            && get(userPath()).data.get('campus', '') == resource.data.campus));

      allow create: if signedIn()
        && exists(userPath())
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'category', 'campus', 'visibility', 'createdBy',
          'members', 'memberCount', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'description', 'category', 'campus', 'visibility', 'createdBy',
          'members', 'memberCount', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.category is string
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.campus is string
        && request.resource.data.campus.size() > 0
        && request.resource.data.campus == get(userPath()).data.campus
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt is timestamp
        && existsAfter(memberIndexPath(request.auth.uid))
        && getAfter(memberIndexPath(request.auth.uid)).data.spaceId == spaceId;

      // The members array is the membership source of truth. Set sizes prevent
      // duplicate UIDs; updates add/remove the caller or repair duplicates without
      // changing the set of actual members.
      allow update: if signedIn()
        && (isPublicSpace()
          || (isCampusScopedSpace() && isSameCampus())
          || request.auth.uid in resource.data.members
          || resource.data.createdBy == request.auth.uid
          || isStaff())
        && resource.data.members is list
        && request.resource.data.members is list
        && isUniqueList(request.resource.data.members)
        && request.resource.data.memberCount == request.resource.data.members.size()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount', 'membershipApproval'])
        && !('membershipApproval' in request.resource.data)
        && (
          isApprovedPrivateJoin()
          || isJoin()
          || isLeave()
          || isMembershipRepair()
        );

      allow delete: if false;

      match /joinRequests/{requestUid} {
        function notificationPath(notificationId) {
          return /databases/$(database)/documents/notifications/$(notificationId);
        }

        function canReviewRequests() {
          return isOwner() || isStaff();
        }

        function canResetRequest() {
          return signedIn()
            && request.auth.uid == requestUid
            && resource.data.uid == requestUid
            && resource.data.status in ['approved', 'rejected']
            && resource.data.createdAt is timestamp
            && exists(spacePath())
            && !(request.auth.uid in get(spacePath()).data.members)
            && request.resource.data.keys().hasOnly(['uid', 'status', 'createdAt', 'notificationKey'])
            && request.resource.data.keys().hasAll(['uid', 'status', 'createdAt', 'notificationKey'])
            && request.resource.data.uid == requestUid
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt is timestamp
            && request.resource.data.createdAt > resource.data.createdAt
            && request.resource.data.notificationKey is string
            && request.resource.data.notificationKey != resource.data.get('notificationKey', '')
            && existsAfter(notificationPath(request.resource.data.notificationKey))
            && !('reviewedBy' in request.resource.data)
            && !('reviewedAt' in request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'createdAt', 'reviewedBy', 'reviewedAt', 'notificationKey'
            ]);
        }

        allow get: if signedIn() && (request.auth.uid == requestUid || canReviewRequests());
        allow list: if canReviewRequests();

        // Any signed-in user with a private Space link may ask to join without
        // being able to read the Space or its content.
        allow create: if signedIn()
          && request.auth.uid == requestUid
          && exists(spacePath())
          && isPrivateData(get(spacePath()).data)
          && !(request.auth.uid in get(spacePath()).data.members)
          && request.auth.uid != get(spacePath()).data.createdBy
          && request.resource.data.keys().hasOnly(['uid', 'status', 'createdAt', 'notificationKey'])
          && request.resource.data.keys().hasAll(['uid', 'status', 'createdAt', 'notificationKey'])
          && request.resource.data.uid == requestUid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt is timestamp
          && request.resource.data.notificationKey is string
          && request.resource.data.notificationKey.size() > 0
          && existsAfter(notificationPath(request.resource.data.notificationKey));

        // Only the owner or staff can approve or decline a pending request.
        allow update: if (
            canReviewRequests()
            && resource.data.uid == requestUid
            && resource.data.status == 'pending'
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status in ['approved', 'rejected']
            && (request.resource.data.status != 'approved' || request.auth.uid != requestUid)
            && request.resource.data.reviewedBy == request.auth.uid
            && request.resource.data.reviewedAt is timestamp
            && request.resource.data.notificationKey is string
            && (!('notificationKey' in resource.data)
              || request.resource.data.notificationKey == resource.data.notificationKey)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reviewedBy', 'reviewedAt', 'notificationKey'
            ])
            && (request.auth.uid == requestUid
              || existsAfter(notificationPath('space_decision_' + request.resource.data.notificationKey)))
          ) || canResetRequest();

        allow delete: if false;
      }

      match /posts/{postId} {
        // Public feeds are campus-wide; private feeds require membership/ownership/staff.
        allow get, list: if canReadSpace();

        allow create: if isMember()
          && request.resource.data.keys().hasOnly([
            'authorName', 'authorUid', 'isAnonymous', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'authorName', 'isAnonymous', 'text', 'createdAt'
          ])
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.isAnonymous is bool
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt is timestamp
          && validAuthorFields();

        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid || isStaff());

        match /comments/{commentId} {
          function parentPostExists() {
            return exists(postPath(postId));
          }

          // Orphan comments are visible only to staff for trusted cleanup.
          allow get, list: if (parentPostExists() && canReadSpace())
            || (!parentPostExists() && isStaff() && exists(spacePath()));

          allow create: if isMember()
            && parentPostExists()
            && request.resource.data.keys().hasOnly([
              'authorName', 'authorUid', 'isAnonymous', 'text', 'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'authorName', 'isAnonymous', 'text', 'createdAt'
            ])
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() <= 80
            && request.resource.data.isAnonymous is bool
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.createdAt is timestamp
            && validAuthorFields();

          allow update: if false;
          allow delete: if signedIn()
            && (
              (parentPostExists() && (resource.data.authorUid == request.auth.uid || isStaff()))
              || (!parentPostExists() && isStaff())
            );
        }
      }
    }
  }
}
